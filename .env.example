# Leave empty for SQLite in the data volume.
# With the postgres profile: postgresql+psycopg://sealedrun:<POSTGRES_PASSWORD>@postgres:5432/sealedrun
SEALEDRUN_DATABASE_URL=
# Required for the postgres profile, no default. Use a long random value.
POSTGRES_PASSWORD=
# Empty = no authentication. Set a long random value before exposing the recorder beyond localhost.
SEALEDRUN_API_TOKEN=
# Principal ids you trust, obtained from the signers and not from a bundle (JSON list). When set,
# bundles from any other principal are refused. Empty = store everything, marked not authenticated.
# SEALEDRUN_TRUSTED_PRINCIPALS=["<principal_id>"]
# Host names the recorder answers to (JSON list). Add the public name when exposing it.
# SEALEDRUN_ALLOWED_HOSTS=["127.0.0.1","localhost","recorder.example.com"]
# External anchoring (SPEC 8), off when empty. Suggested: Sigstore's time-stamp authority, DigiCert
# as fallback, and the public Rekor log. See "Anchoring" in README.md.
# SEALEDRUN_ANCHOR_TSA_URL=https://timestamp.sigstore.dev/api/v1/timestamp
# SEALEDRUN_ANCHOR_TSA_FALLBACK_URL=http://timestamp.digicert.com
# SEALEDRUN_ANCHOR_REKOR_URL=https://rekor.sigstore.dev
# SEALEDRUN_ANCHOR_INTERVAL_SECONDS=600
