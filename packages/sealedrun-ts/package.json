{
  "name": "@sealedrun/core",
  "version": "0.1.1",
  "description": "SealedRun Record verification: canonicalization, hash chain, hybrid signatures",
  "license": "Apache-2.0",
  "author": "SealedRun <info@sealedrun.com>",
  "homepage": "https://sealedrun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealedrun/sealedrun.git",
    "directory": "packages/sealedrun-ts"
  },
  "bugs": "https://github.com/sealedrun/sealedrun/issues",
  "keywords": [
    "ai-agents",
    "audit-trail",
    "hash-chain",
    "ed25519",
    "ml-dsa",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.16.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.1"
  }
}
